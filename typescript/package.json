{
  "name": "cu-pilot-runtime",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "fixtures": "tsx examples/export-fixtures.ts",
    "integration": "npm run build && node --test dist/test/integration/*.test.js",
    "example": "npm run build && node dist/examples/local-batch.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@solana-program/address-lookup-table": "0.15.0",
    "@solana-program/compute-budget": "0.19.0",
    "@solana-program/system": "0.15.0",
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@solana-program/loader-v3": "0.7.0",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
